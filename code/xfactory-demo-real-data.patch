+--   4. Run it BEFORE importing the real manufacturer data (see DEMO_REAL_DATA.md, deployment order).
+--
+--   psql "$DATABASE_URL" -v ON_ERROR_STOP=1 -f 2_apply.sql
+--   (or: python run_seed.py 2_apply.sql ; dry run: SEED_DRY_RUN=1 python run_seed.py 2_apply.sql)
+--
+-- What it changes: organizations.record_type 'REAL' -> 'DEMO' for the records in SCOPE (same rules
+-- as 1_preview.sql), nothing else. updated_at is left alone so "last updated" lists do not change.
+-- Every change is written to record_type_classification_log (with a snapshot of status, approval
+-- and owners) and to admin_change_history (visible in the admin portal's history tab).
+-- It refuses to run a second time, and refuses if the count differs from what you approved.
+-- One transaction: any error leaves nothing changed.
+-- =============================================================================
+BEGIN;
+
+-- >>> EDIT 1: the in_scope_total you reviewed in 1_preview.sql (section B) MINUS the ids you keep REAL.
+CREATE TEMP TABLE demo_params ON COMMIT DROP AS
+SELECT NULL::integer AS expected_count,
+       '023_existing_manufacturers_demo'::text AS run_label;
+
+-- >>> EDIT 2 (optional): ids from the preview that are genuine companies and must stay REAL.
+CREATE TEMP TABLE demo_keep_real (id uuid PRIMARY KEY) ON COMMIT DROP;
+-- INSERT INTO demo_keep_real (id) VALUES
+--   ('00000000-0000-0000-0000-000000000000'),
+--   ('00000000-0000-0000-0000-000000000001');
+
+DO $$
+DECLARE
+  v_expected int; v_label text; v_found int; v_unknown int;
+BEGIN
+  SELECT expected_count, run_label INTO v_expected, v_label FROM demo_params;
+  IF v_expected IS NULL THEN
+    RAISE EXCEPTION '023 apply: set expected_count (EDIT 1) to the number reviewed in 1_preview.sql';
+  END IF;
+  IF to_regclass('public.record_type_classification_log') IS NULL THEN
+    RAISE EXCEPTION '023 apply: run migration 023_record_type_classification.sql first';
+  END IF;
+  IF EXISTS (SELECT 1 FROM record_type_classification_log WHERE run_label = v_label AND rolled_back_at IS NULL) THEN
+    RAISE EXCEPTION '023 apply: already applied (run_label %). It runs only once; later records are classified '
+                    'in the admin portal. Use 4_rollback.sql first if you really need to redo it.', v_label;
+  END IF;
+  SELECT count(*) INTO v_unknown FROM demo_keep_real k
+   WHERE NOT EXISTS (SELECT 1 FROM organizations o WHERE o.id = k.id AND o.organization_type = 'manufacturer');
+  IF v_unknown > 0 THEN
+    RAISE EXCEPTION '023 apply: % KEEP-REAL id(s) are not manufacturer organizations - check EDIT 2', v_unknown;
+  END IF;
+END $$;
+
+-- Freeze the scope once (row locks: nobody can change these rows until COMMIT).
+CREATE TEMP TABLE demo_scope ON COMMIT DROP AS
+SELECT o.id,
+       CASE WHEN o.onboarding_source IS NOT NULL THEN 'existing manufacturer (' || o.onboarding_source || ')'
+            ELSE 'existing manufacturer (source unknown)' END AS rule,
+       jsonb_build_object(
+         'status', o.status, 'verification_status', o.verification_status, 'is_archived', o.is_archived,
+         'created_by_user_id', o.created_by_user_id, 'entry_source', o.entry_source,
+         'onboarding_source', o.onboarding_source,
+         'approval', (SELECT mo.status FROM manufacturer_onboarding mo WHERE mo.organization_id = o.id),
+         'members', coalesce((SELECT jsonb_agg(jsonb_build_object('user_id', m.user_id, 'role', m.membership_role,
+                                                                   'status', m.status) ORDER BY m.user_id)
+                              FROM memberships m WHERE m.organization_id = o.id), '[]'::jsonb)
+       ) AS snapshot
+FROM organizations o
+WHERE o.organization_type = 'manufacturer'
+  AND o.record_type = 'REAL'
+  AND o.created_at < now()                                    -- now() = start of this transaction
+  AND (o.source_ref IS NULL OR o.source_ref NOT LIKE 'india_mfr_research:%')
+  AND NOT EXISTS (SELECT 1 FROM demo_keep_real k WHERE k.id = o.id);
+
+DO $$ BEGIN PERFORM 1 FROM organizations o JOIN demo_scope s ON s.id = o.id FOR UPDATE OF o; END $$;
+
+DO $$
+DECLARE v_expected int; v_found int;
+BEGIN
+  SELECT expected_count INTO v_expected FROM demo_params;
+  SELECT count(*) INTO v_found FROM demo_scope;
+  IF v_found <> v_expected THEN
+    RAISE EXCEPTION '023 apply: % records in scope now, but expected_count is %. Re-run 1_preview.sql and review '
+                    'the difference before applying.', v_found, v_expected;
+  END IF;
+END $$;
+
+INSERT INTO record_type_classification_log (run_label, organization_id, old_record_type, new_record_type, rule, snapshot)
+SELECT p.run_label, s.id, 'REAL', 'DEMO', s.rule, s.snapshot FROM demo_scope s CROSS JOIN demo_params p
+ON CONFLICT (run_label, organization_id) DO UPDATE      -- only after a full 4_rollback.sql
+  SET rule = EXCLUDED.rule, snapshot = EXCLUDED.snapshot, applied_at = now(), rolled_back_at = NULL;
+
+UPDATE organizations o SET record_type = 'DEMO'                -- updated_at intentionally unchanged
+FROM demo_scope s WHERE o.id = s.id AND o.record_type = 'REAL';
+
+INSERT INTO admin_change_history (manufacturer_id, field_changed, old_value, new_value, changed_by, reason)
+SELECT s.id, 'Record type', 'REAL', 'DEMO', NULL,
+       'One-time classification of existing records as demo data (023_existing_manufacturers_demo)'
+FROM demo_scope s;
+
+-- In-transaction checks: abort everything on any mismatch.
+DO $$
+DECLARE v_n int; v_bad int;
+BEGIN
+  SELECT count(*) INTO v_n FROM demo_scope;
+  SELECT count(*) INTO v_bad FROM demo_scope s JOIN organizations o ON o.id = s.id WHERE o.record_type <> 'DEMO';
+  IF v_bad > 0 THEN RAISE EXCEPTION '023 apply: % records did not change', v_bad; END IF;
+  SELECT count(*) INTO v_bad FROM demo_scope s JOIN organizations o ON o.id = s.id
+   WHERE o.status IS DISTINCT FROM s.snapshot->>'status'
+      OR o.verification_status IS DISTINCT FROM s.snapshot->>'verification_status'
+      OR o.created_by_user_id::text IS DISTINCT FROM s.snapshot->>'created_by_user_id'
+      OR o.onboarding_source IS DISTINCT FROM s.snapshot->>'onboarding_source';
+  IF v_bad > 0 THEN RAISE EXCEPTION '023 apply: % records changed more than record_type', v_bad; END IF;
+  SELECT count(*) INTO v_bad FROM organizations o
+   WHERE o.organization_type <> 'manufacturer' AND o.record_type = 'DEMO'
+     AND EXISTS (SELECT 1 FROM demo_scope s WHERE s.id = o.id);
+  IF v_bad > 0 THEN RAISE EXCEPTION '023 apply: non-manufacturer organizations in scope'; END IF;
+  RAISE NOTICE '023 apply OK: % manufacturer records classified DEMO', v_n;
+END $$;
+
+SELECT count(*) AS classified_demo FROM demo_scope;
+
+COMMIT;
diff --git a/backend/database/backfills/023_demo_classification/3_verify.sql b/backend/database/backfills/023_demo_classification/3_verify.sql
new file mode 100644
index 0000000..e8e7997
--- /dev/null
+++ b/backend/database/backfills/023_demo_classification/3_verify.sql
@@ -0,0 +1,61 @@
+-- =============================================================================
+-- 023 / 3_verify.sql — READ ONLY. Run after 2_apply.sql, and again after importing real data.
+-- Every "problems_*" column must be 0.
+-- =============================================================================
+
+-- 1. The one-time run
+SELECT run_label, count(*) AS records, min(applied_at) AS applied_at,
+       count(*) FILTER (WHERE rolled_back_at IS NOT NULL) AS rolled_back
+FROM record_type_classification_log GROUP BY run_label;
+
+-- 2. Integrity of the classified records
+SELECT
+  -- every logged record is DEMO now, unless an admin later switched it (that shows in history)
+  (SELECT count(*) FROM record_type_classification_log l JOIN organizations o ON o.id = l.organization_id
+    WHERE l.rolled_back_at IS NULL AND o.record_type <> 'DEMO'
+      AND NOT EXISTS (SELECT 1 FROM admin_change_history h WHERE h.manufacturer_id = l.organization_id
+                      AND h.field_changed = 'Record type' AND h.created_at > l.applied_at
+                      AND h.reason IS DISTINCT FROM
+                          'One-time classification of existing records as demo data (023_existing_manufacturers_demo)'))
+                                                                                                   AS problems_not_demo,
+  -- nothing created after the run was touched by it
+  (SELECT count(*) FROM record_type_classification_log l JOIN organizations o ON o.id = l.organization_id
+    WHERE o.created_at >= l.applied_at)                                                            AS problems_created_after_run,
+  -- research seed imports are never in the run
+  (SELECT count(*) FROM record_type_classification_log l JOIN organizations o ON o.id = l.organization_id
+    WHERE o.source_ref LIKE 'india_mfr_research:%')                                                AS problems_research_rows_logged,
+  -- only manufacturers
+  (SELECT count(*) FROM record_type_classification_log l JOIN organizations o ON o.id = l.organization_id
+    WHERE o.organization_type <> 'manufacturer')                                                   AS problems_non_manufacturer,
+  -- owners / members unchanged since the run (compared with the snapshot)
+  (SELECT count(*) FROM record_type_classification_log l
+    WHERE l.rolled_back_at IS NULL
+      AND l.snapshot->'members' IS DISTINCT FROM coalesce((
+        SELECT jsonb_agg(jsonb_build_object('user_id', m.user_id, 'role', m.membership_role, 'status', m.status)
+                         ORDER BY m.user_id)
+        FROM memberships m WHERE m.organization_id = l.organization_id), '[]'::jsonb))             AS info_members_changed_since,
+  -- approval unchanged since the run
+  (SELECT count(*) FROM record_type_classification_log l
+    WHERE l.rolled_back_at IS NULL
+      AND (SELECT mo.status FROM manufacturer_onboarding mo WHERE mo.organization_id = l.organization_id)
+          IS DISTINCT FROM l.snapshot->>'approval')                                                AS info_approval_changed_since;
+-- (info_* can grow later through normal admin work; right after 2_apply.sql they must be 0.)
+
+-- 3. Nobody outside the admin portal can see demo data
+SELECT
+  (SELECT count(*) FROM organizations o
+    WHERE o.organization_type = 'manufacturer' AND o.record_type <> 'REAL'
+      AND EXISTS (SELECT 1 FROM admin_manufacturer_overview elig WHERE elig.organization_id = o.id
+                  AND elig.record_type = 'REAL' AND elig.onboarding_raw_status = 'approved'
+                  AND elig.completeness >= 100))                                                   AS problems_demo_visible_to_visionaries,
+  (SELECT count(*) FROM organizations o WHERE o.record_type NOT IN ('REAL', 'DEMO', 'TEST'))         AS problems_invalid_values;
+
+-- 4. Current totals (Real should grow only through self-registration, real imports and admin choices)
+SELECT o.record_type, coalesce(o.onboarding_source, '(unknown)') AS onboarding_source, count(*) AS manufacturers
+FROM organizations o WHERE o.organization_type = 'manufacturer'
+GROUP BY 1, 2 ORDER BY 1, 3 DESC;
+
+-- 5. After importing the real research data: those rows are REAL and none was converted
+SELECT count(*) FILTER (WHERE o.record_type = 'REAL') AS research_rows_real,
+       count(*) FILTER (WHERE o.record_type <> 'REAL') AS problems_research_rows_not_real
+FROM organizations o WHERE o.source_ref LIKE 'india_mfr_research:%';
diff --git a/backend/database/backfills/023_demo_classification/4_rollback.sql b/backend/database/backfills/023_demo_classification/4_rollback.sql
new file mode 100644
index 0000000..28de041
--- /dev/null
+++ b/backend/database/backfills/023_demo_classification/4_rollback.sql
@@ -0,0 +1,43 @@
+-- =============================================================================
+-- 023 / 4_rollback.sql — undo the one-time DEMO classification (2_apply.sql).
+-- =============================================================================
+-- Restores record_type 'REAL' on exactly the records 2_apply.sql changed, EXCEPT records whose
+-- classification an admin has changed since (their later decision is kept; they are listed).
+-- Nothing is deleted. The log rows are kept and marked rolled_back_at; each restore is also
+-- written to admin_change_history. One transaction.
+--   psql "$DATABASE_URL" -v ON_ERROR_STOP=1 -f 4_rollback.sql
+-- =============================================================================
+BEGIN;
+
+CREATE TEMP TABLE rb ON COMMIT DROP AS
+SELECT l.id AS log_id, l.organization_id, o.record_type AS current_type,
+       EXISTS (SELECT 1 FROM admin_change_history h WHERE h.manufacturer_id = l.organization_id
+               AND h.field_changed = 'Record type' AND h.created_at > l.applied_at
+               AND h.reason IS DISTINCT FROM
+                   'One-time classification of existing records as demo data (023_existing_manufacturers_demo)')
+         AS changed_by_admin_since
+FROM record_type_classification_log l JOIN organizations o ON o.id = l.organization_id
+WHERE l.run_label = '023_existing_manufacturers_demo' AND l.rolled_back_at IS NULL;
+
+DO $$ BEGIN PERFORM 1 FROM organizations o JOIN rb r ON r.organization_id = o.id FOR UPDATE OF o; END $$;
+
+-- Kept as they are (an admin decided since the run)
+SELECT r.organization_id, o.display_name, r.current_type AS kept_record_type
+FROM rb r JOIN organizations o ON o.id = r.organization_id
+WHERE r.changed_by_admin_since OR r.current_type <> 'DEMO';
+
+UPDATE organizations o SET record_type = 'REAL'
+FROM rb r WHERE o.id = r.organization_id AND r.current_type = 'DEMO' AND NOT r.changed_by_admin_since;
+
+INSERT INTO admin_change_history (manufacturer_id, field_changed, old_value, new_value, changed_by, reason)
+SELECT r.organization_id, 'Record type', 'DEMO', 'REAL', NULL,
+       'Rollback of the one-time demo classification (023_existing_manufacturers_demo)'
+FROM rb r WHERE r.current_type = 'DEMO' AND NOT r.changed_by_admin_since;
+
+UPDATE record_type_classification_log l SET rolled_back_at = now() FROM rb r WHERE l.id = r.log_id;
+
+SELECT count(*) FILTER (WHERE current_type = 'DEMO' AND NOT changed_by_admin_since) AS restored_real,
+       count(*) FILTER (WHERE current_type <> 'DEMO' OR changed_by_admin_since) AS kept_admin_decision
+FROM rb;
+
+COMMIT;
diff --git a/backend/database/migrations/023_record_type_classification.sql b/backend/database/migrations/023_record_type_classification.sql
new file mode 100644
index 0000000..aa43270
--- /dev/null
+++ b/backend/database/migrations/023_record_type_classification.sql
@@ -0,0 +1,51 @@
+-- 023: Demo vs real manufacturer data. Additive, re-runnable.
+--
+-- Reuses what exists: organizations.record_type (008: 'REAL' | 'DEMO' | 'TEST', NOT NULL,
+-- DEFAULT 'REAL') is the classification. No new column is added. Meaning:
+--   REAL  real manufacturer data. The only records Visionaries can find, view or book
+--         (app/core/eligibility.py) and the only ones counted in real analytics.
+--   DEMO  demonstration data. Kept and inspectable by admins; never shown to Visionaries,
+--         never listed in onboarding company lookup for other users.
+--   TEST  internal test data (existing meaning, same exclusions as DEMO).
+-- It is independent of approval (manufacturer_onboarding.status), verification_status,
+-- onboarding_source, entry_source, profile completeness and ownership (memberships).
+--
+-- Who sets it: self-registration -> column default REAL; CSV import / research seed files /
+-- Admin Entry -> explicit REAL or DEMO; changes afterwards -> administrators / operators only,
+-- with a reason, recorded in admin_change_history.
+--
+-- This migration only (1) re-asserts the column default and constraint, (2) adds the missing
+-- organizations.source_ref column where it is absent (see below), and (3) adds the log
+-- used by the one-time classification of existing records (database/backfills/023_*), so that
+-- run is reviewable, cannot be applied twice, and can be rolled back exactly.
+
+ALTER TABLE organizations ALTER COLUMN record_type SET DEFAULT 'REAL';
+
+-- organizations.source_ref exists in the production / development databases but was never created
+-- by these migrations (schema drift). The research seed files store their stable research id there
+-- ('india_mfr_research:<id>') as their re-run key, and the one-time classification excludes those
+-- rows. No-op where the column already exists.
+ALTER TABLE organizations ADD COLUMN IF NOT EXISTS source_ref TEXT;
+CREATE INDEX IF NOT EXISTS ix_organizations_source_ref ON organizations (source_ref) WHERE source_ref IS NOT NULL;
+DO $$ BEGIN
+  IF NOT EXISTS (SELECT 1 FROM pg_constraint WHERE conname = 'chk_org_record_type') THEN
+    ALTER TABLE organizations ADD CONSTRAINT chk_org_record_type CHECK (record_type IN ('REAL', 'DEMO', 'TEST'));
+  END IF;
+END $$;
+COMMENT ON COLUMN organizations.record_type IS
+  'REAL = real manufacturer data (visible to Visionaries when approved and complete); DEMO / TEST = never shown to Visionaries. Independent of approval, onboarding source and ownership. Changed only by administrators / operators (audited in admin_change_history).';
+
+CREATE TABLE IF NOT EXISTS record_type_classification_log (
+  id               UUID PRIMARY KEY DEFAULT gen_random_uuid(),
+  run_label        TEXT NOT NULL,                 -- e.g. '023_existing_manufacturers_demo'
+  organization_id  UUID NOT NULL REFERENCES organizations(id) ON DELETE CASCADE,
+  old_record_type  TEXT NOT NULL,
+  new_record_type  TEXT NOT NULL,
+  rule             TEXT NOT NULL,                 -- why this record was in scope
+  snapshot         JSONB NOT NULL DEFAULT '{}'::jsonb,  -- status / approval / owners at apply time
+  applied_at       TIMESTAMPTZ NOT NULL DEFAULT now(),
+  rolled_back_at   TIMESTAMPTZ,
+  CONSTRAINT uq_record_type_classification UNIQUE (run_label, organization_id)
+);
+ALTER TABLE record_type_classification_log ENABLE ROW LEVEL SECURITY;
+CREATE INDEX IF NOT EXISTS ix_record_type_classification_org ON record_type_classification_log (organization_id);
