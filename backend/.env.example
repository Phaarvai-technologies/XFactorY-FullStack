ENVIRONMENT=development
# Supabase -> Project Settings -> Database -> connection string, with the asyncpg scheme
DATABASE_URL=postgresql+asyncpg://postgres.PROJECT_REF:PASSWORD@aws-0-ap-south-1.pooler.supabase.com:5432/postgres
# Must include the frontend origin (the browser calls this API directly)
CORS_ORIGINS=["http://localhost:3000"]

CLERK_ISSUER=https://your-instance.clerk.accounts.dev
CLERK_JWKS_URL=https://your-instance.clerk.accounts.dev/.well-known/jwks.json
CLERK_SECRET_KEY=sk_test_replace_me
CLERK_AUTHORIZED_PARTIES=["http://localhost:3000"]
# Optional: only needed for the /api/v1/webhooks/clerk endpoint
CLERK_WEBHOOK_SIGNING_SECRET=

# Supabase Storage for logo / cover / machinery images
SUPABASE_URL=https://PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace_me
SUPABASE_STORAGE_BUCKET=manufacturer-assets
