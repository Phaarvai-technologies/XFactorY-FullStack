# development = API docs at /docs and full database error messages (local only).
# production  = docs switched off and plain error messages. Set ENVIRONMENT=production on Render.
ENVIRONMENT=development
# Supabase -> Project Settings -> Database -> connection string, with the asyncpg scheme
DATABASE_URL=postgresql+asyncpg://postgres.PROJECT_REF:PASSWORD@aws-0-ap-south-1.pooler.supabase.com:5432/postgres
# Must include the frontend origin (the browser calls this API directly)
CORS_ORIGINS=["http://localhost:3000"]

CLERK_ISSUER=https://your-instance.clerk.accounts.dev
CLERK_JWKS_URL=https://your-instance.clerk.accounts.dev/.well-known/jwks.json
CLERK_SECRET_KEY=sk_test_replace_me
CLERK_AUTHORIZED_PARTIES=["http://localhost:3000"]
# Optional: only needed for the /api/v1/webhooks/clerk endpoint
CLERK_WEBHOOK_SIGNING_SECRET=

# Supabase Storage for logo / cover / machinery images
SUPABASE_URL=https://PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace_me
SUPABASE_STORAGE_BUCKET=manufacturer-assets

# Admin Dashboard: comma-separated emails granted admin on first visit to /admin (optional)
ADMIN_EMAILS=
# Built-in administrator created by `python -m app.admin_account setup`
ADMIN_DEFAULT_EMAIL=admin@phaarvai.com
# Admin email + password sign-in (python -m app.admin_account). Defaults shown.
ADMIN_SESSION_HOURS=12
ADMIN_IDLE_MINUTES=60
ADMIN_MAX_FAILED_LOGINS=5
ADMIN_LOCKOUT_MINUTES=15

# Behind the API gateway on a platform where the backend also has a public URL (Render):
# the same random value as the gateway's GATEWAY_SHARED_SECRET. Requests that skip the
# gateway then get 403. Leave empty for local development and docker compose.
GATEWAY_SHARED_SECRET=

# Outgoing email: the app's own emails (welcome, profile review result, account suspended/
# reactivated, admin notices). Empty SMTP_HOST = email off (nothing is sent). Clerk sends its own
# emails (verification codes) itself - nothing is needed here for those.
# To send: your provider's SMTP, e.g. port 587 + starttls (or 465 + ssl) with a username/password.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_SECURITY=starttls
SMTP_TIMEOUT_SECONDS=10
EMAIL_FROM=X!Y Factory <no-reply@xyfactory.local>
# Base address of the frontend, used for links inside emails
APP_BASE_URL=http://localhost:3000
