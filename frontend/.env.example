NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=
NEXT_PUBLIC_CLERK_SIGN_UP_URL=
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=
NEXT_PUBLIC_API_URL=

# --- Only for the deployment served inside the Phaarvai website at /xfactory ---
# Leave these empty for the standalone deployment (it then works exactly as before).
# The Clerk production instance belongs to phaarvai.com, so sign-in works natively on
# https://www.phaarvai.com/xfactory (no proxy; Clerk's automatic vercel.app proxy switched off).
# NEXT_PUBLIC_BASE_PATH=/xfactory
# NEXT_PUBLIC_SITE_ORIGIN=https://www.phaarvai.com
# CLERK_DISABLE_AUTO_PROXY=true
# NEXT_PUBLIC_CLERK_PROXY_URL=   (only if a proxy is configured for the instance in the Clerk dashboard)
